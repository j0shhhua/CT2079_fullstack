NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://eventease:replace-me@127.0.0.1:5432/eventease
DB_SSL=false
# Hosted installations require DB_SSL=true and a trusted CA at DB_CA_FILE.
# DB_CA_FILE=/run/certs/database-ca.pem
# Distinct random secrets, at least 32 characters. Preserve an existing QR_SECRET.
JWT_SECRET=
QR_SECRET=
# No payments enabled by default. Set both values deliberately for a local demo.
PAYMENT_MODE=disabled
ALLOW_SIMULATED_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SES_FROM=
AWS_REGION=ap-southeast-1
SMS_ENABLED=false
TRUST_PROXY_CIDRS=loopback
CRON_SECRET=
ORIGIN_VERIFY_SECRET=
ALLOW_DEMO_SEED=false
DEMO_SEED_PASSWORD=
