NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://eventeaseplus:replace-me@127.0.0.1:5432/eventeaseplus
DB_SSL=false
# Production: DB_SSL=true and a trusted database CA mounted at DB_CA_FILE.
# DB_CA_FILE=/run/certs/database-ca.pem
# Distinct random secrets, at least 32 characters. Preserve QR_SECRET for existing QR tickets.
JWT_SECRET=
QR_SECRET=
# No payments enabled by default. Simulation allowed only outside production.
ALLOW_SIMULATED_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SES_FROM=
AWS_REGION=ap-southeast-1
SMS_ENABLED=false
# Trust only the actual reverse proxy, which must overwrite forwarded headers.
TRUST_PROXY_CIDRS=loopback
CRON_SECRET=
ALLOW_DEMO_SEED=false
DEMO_SEED_PASSWORD=

# Production CloudFront origin custom header X-Origin-Verify; never expose this to browsers.
ORIGIN_VERIFY_SECRET=
