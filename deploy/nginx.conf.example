# Adapt certificate paths and origin hostname before installing on EC2.
# cloudfront-realip.conf must contain set_real_ip_from directives for the current AWS CloudFront origin-facing ranges.
# Security groups must also restrict inbound origin traffic to CloudFront.
server {
    listen 443 ssl;
    server_name origin.example.com;
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    include /etc/nginx/cloudfront-realip.conf;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    client_max_body_size 100k;
    if (-f /run/eventease-maintenance) { return 503; }
    if (-f /run/eventeaseplus-maintenance) { return 503; }
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Origin-Verify $http_x_origin_verify;
        proxy_set_header Cookie $http_cookie;
        proxy_read_timeout 60s;
    }
}
